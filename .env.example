# Copiá a .env.local (o ajustá .env.[mode]) según tu entorno.
# Variables expuestas al cliente: prefijo VITE_

# false en local/CI; true en producción
VITE_PRODUCTION=false

# Base URL del API (axios)
VITE_API_URL=/api

# true = MSW mockea /api/* (solo local/CI; en producción debe ser false)
VITE_USE_MOCKS=true

# Licencia PrimeReact (community / dev)
VITE_PRIMEUI_LICENSE=

# remoteEntry.js del host ATBO (DashboardLayout, sesión standalone)
VITE_HOST_ENTRY=http://localhost:5173/remoteEntry.js
